# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# JWT Configuration
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database Configuration
# PostgreSQL example: postgresql://postgres:password@localhost:5432/forma
# SQLite fallback example: sqlite:///forma.db
DATABASE_URL=sqlite:///forma.db

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760 # 10MB in bytes

# AI / LLM Configuration
LLM_PROVIDER=openai # openai or compatible
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
